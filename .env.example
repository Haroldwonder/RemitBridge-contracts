# ── Core ─────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://remit:remit@localhost:5432/remitbridge

# JWT signing secret — use a long random string in production (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret

# Backend port (optional, defaults to 4000)
PORT=4000

# Comma-separated allowed CORS origins (defaults to localhost dev origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Stellar ───────────────────────────────────────────────────────────────────

# Network: "mainnet" or leave empty for testnet
STELLAR_NETWORK=

# ── TrustFlow Integration ────────────────────────────────────────────────────

# TrustFlow API base URL
TRUSTFLOW_API_URL=https://api.trustflow.opentrust.dev

# TrustFlow API key
TRUSTFLOW_API_KEY=

# Shared secret for verifying incoming TrustFlow webhooks (HMAC-SHA256)
TRUSTFLOW_WEBHOOK_SECRET=

# Minimum trust score required to execute disbursements (default: 30)
MINIMUM_TRUST_SCORE=30

# ── FlowIndexer Integration ──────────────────────────────────────────────────

# FlowIndexer API base URL (leave empty to disable event publishing)
FLOW_INDEXER_URL=https://api.flowindexer.opentrust.dev

# FlowIndexer API key
FLOW_INDEXER_API_KEY=

# Shared secret for verifying incoming FlowIndexer webhooks
FLOWINDEXER_WEBHOOK_SECRET=

# Event poll interval in milliseconds (default: 5000)
EVENT_POLL_INTERVAL_MS=5000
